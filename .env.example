# Server-only address used by Next.js Route Handlers to reach the Go API.
INTERNAL_API_BASE_URL=http://localhost:8083

# Browser-visible application origin used for same-origin mutation checks.
APP_PUBLIC_URL=http://localhost:3000

# Optional server-only credential for a separately hosted production API.
# Leave empty for the existing local development topology.
BFF_GATEWAY_SECRET=

# OAuth provider credentials and SMTP credentials belong to the Go API only.
# Do not expose them through NEXT_PUBLIC_* variables.
